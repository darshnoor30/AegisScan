{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/darshnoor30/AegisScan/schemas/aegisscan-result.schema.json",
  "title": "AegisScan result",
  "type": "object",
  "required": ["schema_version", "scan_id", "engine_version", "started_at", "finished_at", "config", "assets", "observations", "findings", "summary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scan_id": {"type": "string", "format": "uuid"},
    "engine_version": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "config": {"type": "object"},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "summary": {"type": "object"}
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["label", "address", "family", "is_public"],
      "properties": {"label": {"type": "string"}, "address": {"type": "string"}, "family": {"enum": ["IPv4", "IPv6"]}, "is_public": {"type": "boolean"}}
    },
    "observation": {
      "type": "object",
      "required": ["target", "address", "port", "protocol", "state", "fingerprint"],
      "properties": {"target": {"type": "string"}, "address": {"type": "string"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "protocol": {"const": "tcp"}, "state": {"const": "open"}, "latency_ms": {"type": ["number", "null"]}, "fingerprint": {"type": "object"}}
    },
    "finding": {
      "type": "object",
      "required": ["finding_id", "title", "severity", "confidence", "address", "port", "evidence", "impact", "recommendation"],
      "properties": {"finding_id": {"type": "string"}, "title": {"type": "string"}, "severity": {"enum": ["critical", "high", "medium", "low", "informational"]}, "confidence": {"enum": ["high", "medium", "low"]}, "address": {"type": "string"}, "port": {"type": "integer"}, "evidence": {"type": "string"}, "impact": {"type": "string"}, "recommendation": {"type": "string"}}
    }
  }
}

